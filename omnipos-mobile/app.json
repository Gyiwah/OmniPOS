{
  "expo": {
    "name": "OmniPOS",
    "slug": "OmniPOS",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "omnipos",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "@morrowdigital/watermelondb-expo-plugin",
        {
          "disableJsi": true
        }
      ],
      "expo-secure-store"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fafbfb"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "OmniPOS uses Bluetooth to connect to receipt printers.",
        "NSBluetoothPeripheralUsageDescription": "OmniPOS uses Bluetooth to discover and connect to receipt printers."
      }
    },
    "android": {
      "package": "com.gyiwah.omnipos",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fafbfb"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fa2f252b-ac2d-4f7e-87e2-0d7b4a57de4e"
      }
    }
  }
}
