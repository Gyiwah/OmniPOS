# ---------------------------------------------------------------------------
# Backend selection
#
# "laravel" keeps mobile aligned with the web app and the PostgreSQL database.
# Use "supabase" only for a legacy build that is intentionally connected to the
# Supabase project instead of the Laravel API.
#
# EXPO_PUBLIC_API_URL must be reachable FROM THE DEVICE.
# Production / shared backend:
#   EXPO_PUBLIC_API_URL=https://omnipos-9879.onrender.com
# Local API on hardware (localhost is the phone itself):
#   EXPO_PUBLIC_API_URL=http://192.168.x.x:8000
# ---------------------------------------------------------------------------
EXPO_PUBLIC_BACKEND=laravel
EXPO_PUBLIC_API_URL=https://omnipos-9879.onrender.com
