APP_NAME=OmniPOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=omnipos_dev
DB_USERNAME=postgres
DB_PASSWORD=
# Required for Neon when the local libpq client does not support SNI.
# Use the endpoint id at the start of the Neon hostname, e.g. ep-example.
DB_NEON_ENDPOINT=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# Comma-separated origins allowed to hold a Sanctum SPA session (the web client).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173
# Leave null so the session cookie is host-only and works on whichever host
# serves the app (localhost, 127.0.0.1, or a LAN address for a real till).
# Pinning it to one hostname silently breaks the others: the browser refuses the
# cookie and every request fails as "CSRF token mismatch".
SESSION_DOMAIN=null

# Local disk in development; swap to s3 with a bucket for staging/production.
# Product images and store logos are stored under {store_id}/... and served via
# temporary signed URLs, mirroring the access model the Supabase bucket had.
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# How long a pulled change must have been committed before clients may read it.
# See App\Services\Sync\SyncService for why this window exists.
OMNIPOS_SYNC_STABILITY_WINDOW_MS=1000

# Development seed only. Never use the default password in a deployed environment.
OMNIPOS_PLATFORM_ADMIN_NAME="Platform Operator"
OMNIPOS_PLATFORM_ADMIN_EMAIL=super@omnipos.test
OMNIPOS_PLATFORM_ADMIN_PASSWORD=password

# ---------------------------------------------------------------------------
# Supabase source — ONE-TIME DATA MIGRATION ONLY
#
# Read-only. Used solely by omnipos:import-supabase and omnipos:validate-import.
# Find these under Supabase Dashboard -> Project -> Connect (Session pooler or
# direct connection). Remove them once the migration is complete and verified.
# ---------------------------------------------------------------------------
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_DATABASE=postgres
SUPABASE_DB_USERNAME=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require
