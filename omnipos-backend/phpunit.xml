<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <!--
            Unit first: it needs no database and fails in under a second, so a
            broken mapping is reported before the Feature suite spends half a
            minute proving the same thing.

            This directory was not listed at all, so tests in it were silently
            never run — the suite reported green over a file it had not opened.
        -->
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!--
            Tests run against the development database and roll back via
            DatabaseTransactions, so they need no separate database and leave no
            residue. Point DB_DATABASE at omnipos_test once that database exists
            and switch to RefreshDatabase if you want a guaranteed-clean schema.
        -->
    </php>
</phpunit>
