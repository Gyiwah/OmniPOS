# Monorepo root. Each project also carries its own .gitignore; these are the
# patterns that matter regardless of which one a file lands in.

# Dependencies and build output — reproducible from the lockfiles.
node_modules/
vendor/
dist/
dist-ssr/
web-build/
dev-dist/

# Never commit real credentials. Every project ships a .env.example instead.
.env
.env.*
!.env.example

# Expo / React Native
.expo/
expo-env.d.ts
.metro-health-check*
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
# Generated native projects — recreated by `expo prebuild`.
omnipos-mobile/ios/
omnipos-mobile/android/
.kotlin/

# Laravel runtime state
omnipos-backend/storage/logs/*.log
omnipos-backend/storage/framework/cache/*
omnipos-backend/storage/framework/sessions/*
omnipos-backend/storage/framework/views/*
omnipos-backend/bootstrap/cache/*
!**/.gitignore

# TypeScript
*.tsbuildinfo

# Editors and OS
# .cursor/ is deliberately NOT ignored: the rules files in it are project
# standards that belong in the repository.
.idea/
.vscode/
.DS_Store
Thumbs.db
*.pem
npm-debug.*
yarn-debug.*
yarn-error.*
*.log
.neon
